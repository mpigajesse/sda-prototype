# ============================================================
# SDA — Variables d'environnement par nœud
# Copiez ce fichier en .env et adaptez les valeurs
# ============================================================

# ── Identité du nœud ─────────────────────────────────────────
# Nom unique du nœud, affiché dans l'interface "Coffre-fort"
# Exemples : win11 | ubuntu | kali
NODE_NAME=win11

# ── Clé Fernet du coffre-fort (souveraineté des fichiers) ────
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si laissée vide, une clé est générée et persistée dans data/db/.node_vault_key
# IMPORTANT : chaque nœud doit avoir une clé DIFFERENTE
NODE_VAULT_KEY=

# ── Chiffrement SQLite ────────────────────────────────────────
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
DB_ENCRYPTION_KEY=changeme-replace-in-production

# ── Chiffrement Parquet ───────────────────────────────────────
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PARQUET_FERNET_KEY=
