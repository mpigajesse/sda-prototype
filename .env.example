# Copier ce fichier en .env et renseigner les valeurs réelles
# Ne jamais commiter le .env dans git

# Clé SQLCipher pour SQLite (AES-256-CBC)
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
DB_ENCRYPTION_KEY=changeme-replace-in-production

# Clé Fernet pour les fichiers Parquet (AES-128-CBC + HMAC-SHA256)
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PARQUET_FERNET_KEY=
