# Démo publique du nœud SDA — un seul conteneur, gratuit sur Render.
#
# Différences avec docker-compose.yml (déploiement réel) : pas de Nginx/mTLS
# (Render termine le TLS), pas de Syncthing (le cluster est simulé par
# backend/app/demo.py), frontend construit puis servi par FastAPI (même origine).
# Le disque est éphémère : la démo revient à son état initial à chaque réveil.

FROM node:22-bookworm-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# Le lien « GUI Syncthing » pointe vers une page d'explication, pas vers localhost:8384.
ENV VITE_SYNCTHING_GUI_URL=/syncthing-gui
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./app
COPY --from=frontend /frontend/dist ./frontend/dist
ENV FRONTEND_DIST=/app/frontend/dist \
    DB_SQLITE_PATH=/app/data/db/metadata.db \
    DB_DUCKDB_PATH=/app/data/db/analytics.duckdb \
    SHARED_STORAGE_PATH=/app/data/shared_storage \
    NODE_NAME=win11
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
